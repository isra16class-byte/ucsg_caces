# Copiá este archivo como ".env" (sin ".example") y poné tus propios datos.

DB_NAME=nombre_de_tu_base
DB_USER=usuario_de_prueba
DB_PASSWORD=tu_password_local
DB_HOST=localhost
DB_PORT=3306

# Integración de evidencias con OneDrive (Microsoft Graph API). Ver
# seguimiento_syllabus/onedrive_service.py. Credenciales de Azure AD:
# tenant de prueba "Microsoft 365 Apps for business" (trial, vence
# 12/8/2026 — renovar o migrar a cuenta institucional de la UCSG antes
# de esa fecha). Cada dev/entorno pega sus propios valores reales en su
# .env local (nunca en este archivo de ejemplo).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
ONEDRIVE_DRIVE_ID=